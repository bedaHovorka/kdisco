root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# `ktlint_official` is a stricter style than the IntelliJ formatter this codebase was
# written with; `intellij_idea` matches `kotlin.code.style=official` in gradle.properties.
ktlint_code_style = intellij_idea
max_line_length = 120
ktlint_standard_filename = disabled
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_function-naming = disabled
ktlint_standard_property-naming = disabled

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
